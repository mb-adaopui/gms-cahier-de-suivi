};

function genToken(id){var str=id+"gms2026secret";var h=0;for(var i=0;i<str.length;i++){h=((h<<5)-h)+str.charCodeAt(i);h|=0;}return Math.abs(h).toString(36).padStart(8,"0");}

var INIT_USERS=[
  {id:"pres",name:"President",role:"dir",pinHash:PIN0,title:"President",email:"",phone:"",registered:true},
  {id:"tres",name:"Moubarak",role:"dir",pinHash:PIN0,title:"Tresorier",email:"",phone:"",registered:true},
  {id:"sec",name:"Secretaire Gen.",role:"dir",pinHash:PIN0,title:"Secretaire General",email:"",phone:"",registered:true},
  {id:"rs",name:"Ref. Salle",role:"ref",pinHash:PIN0,assoc:"ACMS",sid:"salle",email:"",phone:"",registered:false,token:genToken("rs")},
  {id:"rt",name:"Ref. Travaux",role:"ref",pinHash:PIN0,assoc:"ACMS",sid:"trav",email:"",phone:"",registered:false,token:genToken("rt")},
  {id:"rf",name:"Ref. Finance",role:"ref",pinHash:PIN0,assoc:"ACMS",sid:"fin",email:"",phone:"",registered:false,token:genToken("rf")},
  {id:"rd",name:"Ref. Direction",role:"ref",pinHash:PIN0,assoc:"ACMS",sid:"dir2",email:"",phone:"",registered:false,token:genToken("rd")},
  {id:"rc",name:"Ref. Comm.",role:"ref",pinHash:PIN0,assoc:"CCIS",sid:"comm",email:"",phone:"",registered:false,token:genToken("rc")},
  {id:"ra",name:"Ref. Accueil",role:"ref",pinHash:PIN0,assoc:"ACMS",sid:"acc",email:"",phone:"",registered:false,token:genToken("ra")},
  {id:"rso",name:"Ref. Sono",role:"ref",pinHash:PIN0,assoc:"ACMS",sid:"sono",email:"",phone:"",registered:false,token:genToken("rso")},
  {id:"rsa",name:"Ref. Salaries",role:"ref",pinHash:PIN0,assoc:"ACMS",sid:"sal",email:"",phone:"",registered:false,token:genToken("rsa")},
  {id:"re",name:"Ref. Ecole",role:"ref",pinHash:PIN0,assoc:"CCIS",sid:"eco",email:"",phone:"",registered:false,token:genToken("re")},
  {id:"rex",name:"Ref. Relations",role:"ref",pinHash:PIN0,assoc:"ACMS",sid:"ext",email:"",phone:"",registered:false,token:genToken("rex")}
];

var ME=null,TAB="home",DB=null,SK="mq_v13";

function hashPin(p,cb){crypto.subtle.digest("SHA-256",new TextEncoder().encode(p)).then(function(b){cb(Array.from(new Uint8Array(b)).map(function(x){return x.toString(16).padStart(2,"0");}).join(""));});}
function fdt(iso){if(!iso)return"--";var d=new Date(iso);return d.toLocaleDateString("fr-FR",{day:"2-digit",month:"short",year:"numeric"})+" "+d.toLocaleTimeString("fr-FR",{hour:"2-digit",minute:"2-digit"});}
function un(id){if(!DB)return id;var u=DB.users.find(function(x){return x.id===id;});return u?u.name:id;}
function dstat(r){return(r.status==="approved"&&!r.doneAt)?"approved-undone":r.status;}
function toast(msg,ok){var t=document.getElementById("toast");t.textContent=msg;t.style.background=(ok===false)?"#C0392B":"#1B5E42";t.classList.add("show");setTimeout(function(){t.classList.remove("show");},2500);}
function $(id){return document.getElementById(id);}

function getInitDB(){
  return{
    users:JSON.parse(JSON.stringify(INIT_USERS)),
    reqs:[
      {id:"r1",uid:"rs",assoc:"ACMS",type:"reparation",sid:"salle",title:"Fuite robinet wudu",desc:"Robinet no3 fuit.",prio:"urgente",status:"approved",score:1,doneAt:null,createdAt:"2026-06-01T09:15:00",updatedAt:"2026-06-03T11:00:00",files:[],msgs:[{id:"m1",uid:"tres",text:"Approuve.",date:"2026-06-03T11:00:00",type:"comment"}]},
      {id:"r2",uid:"rso",assoc:"ACMS",type:"achat",sid:"sono",title:"Micro sans fil",desc:"Micro defaillant.",prio:"urgente",status:"pending",score:null,doneAt:null,createdAt:"2026-06-10T14:30:00",updatedAt:"2026-06-10T14:30:00",files:[],msgs:[]},
      {id:"r3",uid:"re",assoc:"CCIS",type:"achat",sid:"eco",title:"Manuels arabe",desc:"20 manuels.",prio:"normale",status:"pending",score:null,doneAt:null,createdAt:"2026-06-12T10:00:00",updatedAt:"2026-06-12T10:00:00",files:[],msgs:[]}
    ],
    forum:[{id:"f1",uid:"tres",title:"Reunion Juillet",body:"Reunion le 1er juillet a 20h.",createdAt:"2026-06-15T10:00:00",replies:[{id:"fr1",uid:"rs",text:"Bien recu.",date:"2026-06-15T11:30:00"}],pinned:true}]
  };
}

function saveDB(){try{localStorage.setItem(SK,JSON.stringify(DB));}catch(e){}fetch("https://cahier-de-suivi-c5be6-default-rtdb.europe-west1.firebasedatabase.app/ms026fd5eb47757ec6888247a2.json",{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify(DB)}).catch(function(){});}
function loadDB(cb){
  // Charger immediatement depuis localStorage
  try{var s=localStorage.getItem(SK);DB=s?JSON.parse(s):getInitDB();}catch(e){DB=getInitDB();}
  doMigration(cb);
  // Sync Firebase en arriere-plan
  fetch("https://cahier-de-suivi-c5be6-default-rtdb.europe-west1.firebasedatabase.app/ms026fd5eb47757ec6888247a2.json")
    .then(function(r){return r.json();})
    .then(function(data){
      if(data&&data.users&&data.users.length>0){
        DB=data;try{localStorage.setItem(SK,JSON.stringify(DB));}catch(e){}
        if(!ME)buildSelect();
      } else {
        fetch("https://cahier-de-suivi-c5be6-default-rtdb.europe-west1.firebasedatabase.app/ms026fd5eb47757ec6888247a2.json",{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify(DB)}).catch(function(){});
      }
    }).catch(function(){});
}
function doMigration(cb){
  if(!DB.users){DB=getInitDB();saveDB();cb();return;}
  var changed=false;
  DB.users=DB.users.map(function(u){
    if(u.role==="ref"){
      var x=Object.assign({},u);
      if(!x.token){var iu=INIT_USERS.find(function(i){return i.id===u.id;});x.token=iu?iu.token:Date.now().toString(36);changed=true;}
      if(x.registered===undefined){x.registered=false;changed=true;}
      if(!x.phone){x.phone="";changed=true;}
      return x;
    }
    if(u.role==="dir"&&u.registered===undefined){changed=true;return Object.assign({},u,{registered:true,phone:u.phone||""}); }
    return u;
  });
  if(DB.secs&&Array.isArray(DB.secs)){
    DB.secs.forEach(function(s){
      var idx=-1;for(var i=0;i<SECS.length;i++){if(SECS[i].id===s.id){idx=i;break;}}
      if(idx>=0){SECS[idx]=Object.assign({},SECS[idx],{label:s.label,short:s.short,c:s.c,tips:s.tips||[]});SM[s.id]=SECS[idx];}
    });
  }
  if(changed)saveDB();
  cb();
}
var _polling=false;
function startPoll(){
  if(_polling)return;_polling=true;
  setInterval(function(){
    if(!ME)return;
    fetch("https://cahier-de-suivi-c5be6-default-rtdb.europe-west1.firebasedatabase.app/ms026fd5eb47757ec6888247a2.json")
      .then(function(r){return r.json();})
      .then(function(data){
        if(!data||!data.users)return;
        if(JSON.stringify(data)!==JSON.stringify(DB)){
          DB=data;try{localStorage.setItem(SK,JSON.stringify(DB));}catch(e){}
          render();toast("Synchronise");
        }
      }).catch(function(){});
  },8000);
}

function commit(nd){
  if(ME&&ME.role==="ref"){
    var ok=true;
    nd.reqs.forEach(function(r){if(r.uid!==ME.id){var o=DB.reqs.find(function(x){return x.id===r.id;});if(o&&JSON.stringify(r)!==JSON.stringify(o))ok=false;}});
    nd.users.forEach(function(u){if(u.id!==ME.id){var o=DB.users.find(function(x){return x.id===u.id;});if(o&&JSON.stringify(u)!==JSON.stringify(o))ok=false;}});
    if(!ok){toast("Action non autorisee.",false);return;}
  }
  DB=nd;saveDB();render();
}

// ── DOM helpers ──
function el(tag,attrs,children){
  var e=document.createElement(tag);
  if(attrs)Object.keys(attrs).forEach(function(k){
    if(k==="style"&&typeof attrs[k]==="object"){Object.assign(e.style,attrs[k]);}
    else if(k==="cls"){e.className=attrs[k];}
    else if(k==="txt"){e.textContent=attrs[k];}
    else if(k==="html"){e.innerHTML=attrs[k];}
    else{e.setAttribute(k,attrs[k]);}
  });
  if(children)children.forEach(function(c){if(c)e.appendChild(typeof c==="string"?document.createTextNode(c):c);});
  return e;
}
function bdg(bg,c,t){var s=el("span",{cls:"bdg"});s.style.background=bg;s.style.color=c;s.textContent=t;return s;}
function stbdg(r){var s=ST[dstat(r)]||ST.pending;return bdg(s.bg,s.c,s.l);}
function tybdg(r){var t=TY[r.type]||TY.tache;return bdg(t.bg,t.c,t.l);}
function atag(a){var s=el("span",{cls:"atag"});s.textContent=a;return s;}
function btn(txt,cls,onclick){var b=el("button",{cls:"btn "+cls,txt:txt});b.onclick=onclick;return b;}

function openModal(ttl,fillFn){
  $("modal-ttl").textContent=ttl;
  var body=$("modal-body");
  body.innerHTML="";
  fillFn(body);
  $("modal-ov").classList.add("open");
  $("modal-box").scrollTop=0;
}
function closeModal(){$("modal-ov").classList.remove("open");}

// ── INIT ──
window.onload=function(){
  // Set logos
  var lg=$("lg-logo");if(lg)lg.src=LOGO;
  var il=$("inv-logo");if(il)il.src=LOGO;
  var tl=$("tb-logo");if(tl)tl.src=LOGO;

  loadDB(function(){
    var params=new URLSearchParams(window.location.search);
    var token=params.get("invite");
    if(token){
      var u=DB.users.find(function(x){return x.token===token;});
      if(!u){var iu=INIT_USERS.find(function(x){return x.token===token;});if(iu){u=DB.users.find(function(x){return x.id===iu.id;});}}
      if(u){showInvite(u);return;}
    }
    showLogin();
  });
};

function showLogin(){
  $("invite-wrap").style.display="none";
  $("login-wrap").style.display="flex";
  $("topbar").style.display="none";
  $("content").style.display="none";
  buildSelect();
}

function showInvite(u){
  var sec=SM[u.sid]||null;
  var banner=$("inv-banner");
  if(sec){banner.textContent="Secteur : "+sec.label;banner.style.background=sec.bg;banner.style.color=sec.c;}
  if(u.name&&u.name!==u.id)$("inv-name").value=u.name;
  if(u.email)$("inv-email").value=u.email;
  if(u.phone)$("inv-phone").value=u.phone;
  $("invite-wrap").style.display="flex";
  $("login-wrap").style.display="none";
  $("topbar").style.display="none";
  $("content").style.display="none";

  $("inv-btn").onclick=function(){
    var name=$("inv-name").value.trim();
    var p1=$("inv-p1").value;
    var p2=$("inv-p2").value;
    var err=$("inv-err");
    if(!name){err.textContent="Nom requis.";err.style.display="";return;}
    if(p1.length<4){err.textContent="Code minimum 4 caracteres.";err.style.display="";return;}
    if(p1!==p2){err.textContent="Codes differents.";err.style.display="";return;}
    err.style.display="none";
    hashPin(p1,function(ph){
      var nd=JSON.parse(JSON.stringify(DB));
      nd.users=nd.users.map(function(x){
        if(x.id!==u.id)return x;
        return Object.assign({},x,{name:name,email:$("inv-email").value.trim(),phone:$("inv-phone").value.trim(),pinHash:ph,registered:true});
      });
      DB=nd;saveDB();
      ME=nd.users.find(function(x){return x.id===u.id;});
      TAB="home";
      $("invite-wrap").style.display="none";
      $("topbar").style.display="flex";
      $("content").style.display="block";
      toast("Bienvenue "+name+" !");
      render();
    });
  };
}

function buildSelect(){
  var sel=$("l-uid");sel.innerHTML="";
  var dirs=DB.users.filter(function(u){return u.role==="dir";});
  var refs=DB.users.filter(function(u){return u.role==="ref";});
  var g1=document.createElement("optgroup");g1.label="Direction";
  dirs.forEach(function(u){var o=document.createElement("option");o.value=u.id;o.textContent=u.name+" ("+u.title+")";g1.appendChild(o);});
  sel.appendChild(g1);
  var g2=document.createElement("optgroup");g2.label="Referents";
  refs.forEach(function(u){var s=SM[u.sid];var o=document.createElement("option");o.value=u.id;o.textContent=(s?"("+s.short+") ":"")+u.name;g2.appendChild(o);});
  sel.appendChild(g2);
}

$("l-btn").onclick=function(){
  if(!DB||!DB.users){toast("Chargement en cours...",false);return;}
  var uid=$("l-uid").value;
  var u=DB.users.find(function(x){return x.id===uid;});
  if(!u){$("l-err").textContent="Introuvable.";$("l-err").style.display="";return;}
  hashPin($("l-pin").value,function(h){
    if(h!==u.pinHash){$("l-err").textContent="Code incorrect.";$("l-err").style.display="";return;}
    $("l-err").style.display="none";
    ME=u;TAB="home";
    $("login-wrap").style.display="none";
    $("login-general").style.display="block";
    $("login-ref").style.display="none";
    $("topbar").style.display="flex";
    $("content").style.display="block";
    startPoll();
    render();
  });
};
$("l-pin").addEventListener("keydown",function(e){if(e.key==="Enter")$("l-btn").click();});

$("l-btn-other").onclick=function(){
  $("login-ref").style.display="none";
  $("login-general").style.display="block";
  buildSelect();
};

$("btn-exit").onclick=function(){
  var wasRef=ME&&ME.role==="ref";
  var last=ME;
  ME=null;
  $("topbar").style.display="none";
  $("content").style.display="none";
  $("menu-ov").style.display="none";
  $("login-wrap").style.display="flex";
  $("l-pin").value="";
  $("l-pin-ref").value="";
  if(wasRef&&last){
    var sec=SM[last.sid]||null;
    var b=$("lr-banner");
    b.textContent=last.name+(sec?" - "+sec.label:"");
    b.style.background=sec?sec.bg:"#E8F5EE";
    b.style.color=sec?sec.c:"#1B5E42";
    $("login-general").style.display="none";
    $("login-ref").style.display="block";
    $("l-btn-ref").onclick=function(){
      hashPin($("l-pin-ref").value,function(h){
        if(h!==last.pinHash){$("l-err-ref").textContent="Code incorrect.";$("l-err-ref").style.display="";return;}
        $("l-err-ref").style.display="none";
        ME=last;TAB="home";
        $("login-wrap").style.display="none";
        $("topbar").style.display="flex";
        $("content").style.display="block";
        render();
      });
    };
    $("l-pin-ref").onkeydown=function(e){if(e.key==="Enter")$("l-btn-ref").click();};
  } else {
    $("login-general").style.display="block";
    $("login-ref").style.display="none";
    buildSelect();
  }
};

$("btn-menu").onclick=function(){var o=$("menu-ov");o.style.display=o.style.display==="block"?"none":"block";};
$("menu-ov").onclick=function(e){if(e.target===$("menu-ov"))$("menu-ov").style.display="none";};
$("modal-x").onclick=closeModal;
$("modal-ov").onclick=function(e){if(e.target===$("modal-ov"))closeModal();};

document.addEventListener("click",function(e){
  var gt=e.target.closest("[data-gt]");if(gt)goTab(gt.getAttribute("data-gt"));
  var tip=e.target.closest("[data-tip]");if(tip){var t=$("nq-ttl");if(t)t.value=tip.textContent;}
});

function getTabs(){
  var isDir=ME&&ME.role==="dir";
  var pend=DB.reqs.filter(function(r){return r.status==="pending";}).length;
  if(isDir)return[{id:"home",l:"Accueil"},{id:"reqs",l:"Demandes",b:pend||0},{id:"secs",l:"Secteurs"},{id:"refs",l:"Equipe"},{id:"invites",l:"Invitations"},{id:"forum",l:"Forum"},{id:"cfg",l:"Config"}];
  return[{id:"home",l:"Accueil"},{id:"new",l:"Nouveau"},{id:"mine",l:"Mes dem."},{id:"cfg",l:"Config"}];
}
function goTab(id){TAB=id;$("menu-ov").style.display="none";render();}

function render(){
  if(!ME)return;
  var isDir=ME.role==="dir";
  var sec=SM[ME.sid]||null;
  $("tb-sub").textContent=ME.name+(isDir?" - "+ME.title:sec?" - "+sec.short:"");
  var tabs=getTabs();
  var mi=$("menu-items");mi.innerHTML="";
  $("menu-hdr-role").textContent=isDir?"Direction":"Referent";
  $("menu-hdr-name").textContent=ME.name;
  tabs.forEach(function(t){
    var b=document.createElement("button");
    b.className="mi"+(TAB===t.id?" on":"");
    b.textContent=t.l;
    if(t.b){var bx=document.createElement("span");bx.className="mbdg";bx.textContent=t.b;b.appendChild(bx);}
    b.onclick=function(){goTab(t.id);};
    mi.appendChild(b);
  });
  var c=$("content");
  c.innerHTML="";
  if(TAB==="home")renderHome(c);
  else if(TAB==="new")renderNew(c);
  else if(TAB==="mine"||TAB==="reqs")renderList(c,TAB==="mine"||!isDir);
  else if(TAB==="secs")renderSecs(c);
  else if(TAB==="refs")renderRefs(c);
  else if(TAB==="invites")renderInvites(c);
  else if(TAB==="forum")renderForum(c);
  else if(TAB==="cfg")renderCfg(c);
}

// ── RCARD helper (uses createElement) ──
function makeRcard(r,clickable){
  var sec=SM[r.sid]||null;
  var d=el("div",{cls:"card"+(clickable?" rcard":""),"data-rid":r.id});
  d.style.cursor=clickable?"pointer":"default";
  if(clickable)d.onclick=function(){openReqModal(r.id);};
  var top=el("div",{style:{display:"flex",justifyContent:"space-between",gap:"8px",marginBottom:"6px"}});
  var left=el("div",{style:{flex:"1",minWidth:"0"}});
  left.appendChild(el("div",{cls:"rttl",txt:r.title}));
  left.appendChild(el("div",{cls:"rwho",txt:un(r.uid)+(sec?" - "+sec.short:"")}));
  left.appendChild(el("div",{cls:"rdt",txt:fdt(r.createdAt)}));
  var right=el("div",{style:{display:"flex",flexDirection:"column",alignItems:"flex-end",gap:"3px"}});
  right.appendChild(stbdg(r));right.appendChild(atag(r.assoc));
  top.appendChild(left);top.appendChild(right);d.appendChild(top);
  var chips=el("div",{style:{display:"flex",gap:"4px",flexWrap:"wrap"}});
  chips.appendChild(tybdg(r));
  if(r.prio==="urgente")chips.appendChild(bdg("#FEE2E2","#C0392B","URGENT"));
  if(r.score===1){var s=el("span",{style:{fontSize:".62rem",color:"#C8A84B"},txt:"Bon pt"});chips.appendChild(s);}
  if(r.score===0){var s=el("span",{style:{fontSize:".62rem",color:"#C0392B"},txt:"Mauvais pt"});chips.appendChild(s);}
  if((r.files||[]).length){var s=el("span",{style:{fontSize:".6rem",color:"#718096"},txt:r.files.length+" fich."});chips.appendChild(s);}
  if((r.msgs||[]).length){var s=el("span",{style:{fontSize:".6rem",color:"#718096"},txt:r.msgs.length+" msg"});chips.appendChild(s);}
  d.appendChild(chips);
  return d;
}

function renderHome(c){
  var isDir=ME.role==="dir";
  var reqs=isDir?DB.reqs:DB.reqs.filter(function(r){return r.uid===ME.id;});
  var sec=SM[ME.sid]||null;
  c.appendChild(el("h2",{style:{fontSize:"1rem",fontWeight:"800",color:G,margin:"0 0 10px"},txt:isDir?"Vue ensemble":"Bonjour, "+ME.name}));
  var g=el("div",{cls:"g2",style:{marginBottom:"10px"}});
  [{n:reqs.length,l:"Total",c:G},{n:reqs.filter(function(r){return r.status==="pending";}).length,l:"En attente",c:"#856404"},{n:reqs.filter(function(r){return r.status==="approved"&&!r.doneAt;}).length,l:"Non faites",c:"#b45309"},{n:reqs.filter(function(r){return r.status==="done";}).length,l:"Effectuees",c:"#3730A3"}].forEach(function(s){
    var card=el("div",{cls:"card",style:{textAlign:"center",padding:"10px"}});
    card.appendChild(el("div",{style:{fontSize:"1.5rem",fontWeight:"800",color:s.c},txt:""+s.n}));
    card.appendChild(el("div",{style:{fontSize:".63rem",color:GSL},txt:s.l}));
    g.appendChild(card);
  });
  c.appendChild(g);
  if(isDir){
    c.appendChild(el("div",{style:{fontSize:".66rem",fontWeight:"700",color:"#4A5568",textTransform:"uppercase",marginBottom:"6px"},txt:"Activite"}));
    var g2=el("div",{cls:"g2",style:{marginBottom:"10px"}});
    SECS.forEach(function(s){
      var n=DB.reqs.filter(function(r){return r.sid===s.id;}).length;
      var a=DB.reqs.filter(function(r){return r.sid===s.id&&r.status==="pending";}).length;
      var card=el("div",{style:{background:s.bg,borderRadius:"8px",padding:"8px 10px",border:"1px solid "+s.c+"22"}});
      card.appendChild(el("div",{style:{fontWeight:"700",fontSize:".72rem",color:s.c},txt:s.short}));
      card.appendChild(el("div",{style:{fontSize:".62rem",color:GSL},txt:n+" dem."+(a?" / "+a+" att.":"")}));
      g2.appendChild(card);
    });
    c.appendChild(g2);
  }
  if(!isDir&&sec){
    var card=el("div",{cls:"card",style:{background:sec.bg,border:"1px solid "+sec.c+"44",marginBottom:"10px"}});
    card.appendChild(el("div",{style:{fontWeight:"700",fontSize:".82rem",color:sec.c,marginBottom:"7px"},txt:sec.label}));
    var btns=el("div",{style:{display:"flex",gap:"8px",flexWrap:"wrap"}});
    var b1=btn("+ Nouvelle demande","bg bsm",function(){goTab("new");});
    var b2=btn("Mes demandes","bgr bsm",function(){goTab("mine");});
    btns.appendChild(b1);btns.appendChild(b2);card.appendChild(btns);c.appendChild(card);
  }
  c.appendChild(el("div",{style:{fontSize:".66rem",fontWeight:"700",color:"#4A5568",textTransform:"uppercase",marginBottom:"6px"},txt:"Recentes"}));
  var rec=[].concat(reqs).sort(function(a,b){return b.updatedAt.localeCompare(a.updatedAt);}).slice(0,5);
  if(!rec.length)c.appendChild(el("div",{cls:"empty",txt:"Aucune demande."}));
  else rec.forEach(function(r){c.appendChild(makeRcard(r,true));});
}

function renderList(c,mine){
  var isDir=ME.role==="dir";
  var sf=window._sf||"all",sf2=window._sf2||"all";
  var base=mine?DB.reqs.filter(function(r){return r.uid===ME.id;}):DB.reqs;
  var list=base.filter(function(r){
    var ok1=sf==="all"?true:sf==="approved-undone"?(r.status==="approved"&&!r.doneAt):r.status===sf;
    var ok2=sf2==="all"?true:r.sid===sf2;
    return ok1&&ok2;
  }).sort(function(a,b){return b.updatedAt.localeCompare(a.updatedAt);});
  var h2=el("h2",{style:{fontSize:"1rem",fontWeight:"800",color:G,margin:"0 0 8px"}});
  h2.textContent=mine?"Mes demandes":"Toutes";
  var cnt=el("span",{style:{fontSize:".66rem",color:GSL,fontWeight:"400",marginLeft:"6px"}});
  cnt.textContent=list.length+" dem.";h2.appendChild(cnt);c.appendChild(h2);
  var sfs=[{v:"all",l:"Toutes"},{v:"pending",l:"Attente"},{v:"approved",l:"Approuvees"},{v:"rejected",l:"Refusees"},{v:"done",l:"Effectuees"},{v:"approved-undone",l:"Non faites"}];
  var frow=el("div",{cls:"fbtns"});
  sfs.forEach(function(f){var b=el("button",{cls:"fbtn"+(sf===f.v?" on":""),txt:f.v.replace("approved-undone","approved-undone")});b.textContent=f.l;b.onclick=function(){window._sf=f.v;renderList(c,mine);};frow.appendChild(b);});
  c.appendChild(frow);
  if(isDir){
    var frow2=el("div",{cls:"fbtns"});
    var ba=el("button",{cls:"fbtn"+(sf2==="all"?" on":""),txt:"Tous"});ba.onclick=function(){window._sf2="all";renderList(c,mine);};frow2.appendChild(ba);
    SECS.forEach(function(s){var b=el("button",{cls:"fbtn"+(sf2===s.id?" on":""),txt:s.short});if(sf2===s.id){b.style.borderColor=s.c;b.style.background=s.bg;b.style.color=s.c;}b.onclick=function(){window._sf2=s.id;renderList(c,mine);};frow2.appendChild(b);});
    c.appendChild(frow2);
  }
  if(!list.length)c.appendChild(el("div",{cls:"empty",txt:"Aucune demande."}));
  else list.forEach(function(r){c.appendChild(makeRcard(r,true));});
}

function renderNew(c){
  var sec=SM[ME.sid]||null;
  c.appendChild(el("h2",{style:{fontSize:"1rem",fontWeight:"800",color:G,margin:"0 0 8px"},txt:"Nouvelle demande"}));
  if(sec){var b=el("div",{cls:"card",style:{background:sec.bg,border:"1px solid "+sec.c+"33",marginBottom:"8px"}});b.appendChild(el("div",{style:{fontWeight:"700",fontSize:".78rem",color:sec.c},txt:sec.label}));c.appendChild(b);}
  var card=el("div",{cls:"card"});
  var g=el("div",{cls:"g2"});
  var fa=el("div",{cls:"fg"});fa.appendChild(el("label",{txt:"Association"}));var sa=document.createElement("select");sa.id="nq-a";["ACMS","CCIS"].forEach(function(v){var o=document.createElement("option");o.value=v;o.textContent=v;sa.appendChild(o);});fa.appendChild(sa);g.appendChild(fa);
  var ft=el("div",{cls:"fg"});ft.appendChild(el("label",{txt:"Type"}));var st=document.createElement("select");st.id="nq-t";[["reparation","Reparation"],["achat","Achat"],["tache","Tache"]].forEach(function(v){var o=document.createElement("option");o.value=v[0];o.textContent=v[1];st.appendChild(o);});ft.appendChild(st);g.appendChild(ft);
  card.appendChild(g);
  var fttl=el("div",{cls:"fg"});fttl.appendChild(el("label",{txt:"Objet"}));var inp=document.createElement("input");inp.id="nq-ttl";inp.placeholder="Resumez la demande...";fttl.appendChild(inp);card.appendChild(fttl);
  if(sec&&sec.tips){
    var ftips=el("div",{cls:"fg"});ftips.appendChild(el("label",{txt:"Suggestions"}));
    var tips=el("div",{style:{display:"flex",gap:"5px",flexWrap:"wrap",marginTop:"4px"}});
    sec.tips.forEach(function(tip){var b=document.createElement("button");b.className="btn bsm";b.style.background=sec.bg;b.style.color=sec.c;b.style.border="1px solid "+sec.c+"44";b.textContent=tip;b.setAttribute("data-tip","1");tips.appendChild(b);});
    ftips.appendChild(tips);card.appendChild(ftips);
  }
  var fd=el("div",{cls:"fg"});fd.appendChild(el("label",{txt:"Description"}));var ta=document.createElement("textarea");ta.id="nq-d";fd.appendChild(ta);card.appendChild(fd);
  var fp=el("div",{cls:"fg"});fp.appendChild(el("label",{txt:"Priorite"}));var sp=document.createElement("select");sp.id="nq-p";[["normale","Normale"],["urgente","URGENTE"],["faible","Faible"]].forEach(function(v){var o=document.createElement("option");o.value=v[0];o.textContent=v[1];sp.appendChild(o);});fp.appendChild(sp);card.appendChild(fp);
  var nqFiles=[];
  var fdrop=el("div",{cls:"fg"});fdrop.appendChild(el("label",{txt:"Pieces jointes"}));
  var drop=el("div",{style:{border:"2px dashed #E2E0DB",borderRadius:"7px",padding:"10px",cursor:"pointer",textAlign:"center",fontSize:".74rem",color:GSL},txt:"Appuyer pour joindre"});
  var fi=document.createElement("input");fi.type="file";fi.multiple=true;fi.accept="image/*,.pdf";fi.style.display="none";
  drop.onclick=function(){fi.click();};
  fi.onchange=function(e){Array.from(e.target.files).forEach(function(f){var rd=new FileReader();rd.onload=function(ev){nqFiles.push({name:f.name,type:f.type,size:f.size,data:ev.target.result});};rd.readAsDataURL(f);});};
  fdrop.appendChild(drop);fdrop.appendChild(fi);card.appendChild(fdrop);
  var sub=btn("Soumettre","bg bfull",function(){
    var ttl=$("nq-ttl").value.trim();if(!ttl){toast("Objet requis.",false);return;}
    var now=new Date().toISOString();
    var nd=JSON.parse(JSON.stringify(DB));
    nd.reqs.push({id:"r"+Date.now(),uid:ME.id,sid:ME.sid,assoc:$("nq-a").value,type:$("nq-t").value,title:ttl,desc:$("nq-d").value,prio:$("nq-p").value,status:"pending",score:null,createdAt:now,updatedAt:now,doneAt:null,files:nqFiles,msgs:[]});
    commit(nd);toast("Demande soumise !");TAB="mine";render();
  });
  card.appendChild(sub);c.appendChild(card);
}

function renderSecs(c){
  if(ME.role!=="dir"){c.appendChild(el("div",{cls:"empty",txt:"Acces restreint."}));return;}
  var mode=window._secsMode||"list"; // "list" or "manage"
  var sel=window._selSec||null,sf=window._sfSec||"all";

  var hdr=el("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:"8px"}});
  hdr.appendChild(el("h2",{style:{fontSize:"1rem",fontWeight:"800",color:G,margin:"0"},txt:"Secteurs"}));
  var btnsHdr=el("div",{style:{display:"flex",gap:"6px"}});
  var modeLbl=mode==="manage"?"Voir demandes":"Gerer secteurs";
  var modeBtn=document.createElement("button");
  modeBtn.className="btn bgr bsm";
  modeBtn.textContent=modeLbl;
  modeBtn.onclick=function(){
    window._secsMode=(window._secsMode==="manage")?"list":"manage";
    render();
  };
  btnsHdr.appendChild(modeBtn);
  if(mode==="list")btnsHdr.appendChild(btn("PDF tout","bgr bsm",function(){pdfHisto(DB.reqs,"Historique complet");}));
  hdr.appendChild(btnsHdr);c.appendChild(hdr);

  if(mode==="manage"){
    // ── MODE GESTION : modifier secteurs et referents ──
    c.appendChild(el("p",{style:{fontSize:".72rem",color:GSL,marginBottom:"10px"},txt:"Modifiez les secteurs et assignez jusqu a 3 referents par secteur."}));
    SECS.forEach(function(s){
      var refs=DB.users.filter(function(u){return u.role==="ref"&&u.sid===s.id;});
      var allRefs=DB.users.filter(function(u){return u.role==="ref";});
      var card=el("div",{cls:"card",style:{marginBottom:"8px",borderLeft:"4px solid "+s.c}});
      // Header secteur
      var sh=el("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:"8px"}});
      var sl=el("div");
      var stitle=el("div",{style:{fontWeight:"800",fontSize:".84rem",color:s.c},txt:s.label});
      var ssub=el("div",{style:{fontSize:".62rem",color:GSL},txt:refs.length+"/3 referent"+(refs.length>1?"s":"")});
      sl.appendChild(stitle);sl.appendChild(ssub);sh.appendChild(sl);
      sh.appendChild(btn("Modifier secteur","bgr bsm",function(sec){return function(){openSecModal(sec);};}(s)));
      card.appendChild(sh);
      // Referents actuels
      if(refs.length){
        var rlist=el("div",{style:{marginBottom:"8px"}});
        refs.forEach(function(u){
          var row=el("div",{style:{display:"flex",alignItems:"center",gap:"8px",padding:"5px 8px",background:s.bg,borderRadius:"6px",marginBottom:"4px"}});
          var info=el("div",{style:{flex:"1",minWidth:"0"}});
          info.appendChild(el("div",{style:{fontWeight:"700",fontSize:".78rem",color:s.c},txt:u.name}));
          info.appendChild(el("div",{style:{fontSize:".62rem",color:GSL},txt:u.registered?"Inscrit":"En attente"}));
          row.appendChild(info);
          row.appendChild(btn("Retirer","br bsm",function(uid,secid){return function(){
            if(!confirm("Retirer ce referent du secteur ?"))return;
            var nd=JSON.parse(JSON.stringify(DB));
            nd.users=nd.users.map(function(x){return x.id===uid?Object.assign({},x,{sid:""}):x;});
            commit(nd);
          };}(u.id,s.id)));
          rlist.appendChild(row);
        });
        card.appendChild(rlist);
      }
      // Ajouter referent (si < 3)
      if(refs.length<3){
        var avail=allRefs.filter(function(u){return !u.sid||u.sid==="";});
        if(avail.length){
          var addRow=el("div",{style:{display:"flex",gap:"6px",alignItems:"center"}});
          var sel2=document.createElement("select");
          sel2.style.cssText="flex:1;padding:6px 8px;border:1.5px solid #E2E0DB;border-radius:7px;font-family:inherit;font-size:.78rem;background:#F8F7F4;";
          var opt0=document.createElement("option");opt0.value="";opt0.textContent="-- Choisir un referent --";sel2.appendChild(opt0);
          avail.forEach(function(u){var o=document.createElement("option");o.value=u.id;o.textContent=u.name;sel2.appendChild(o);});
          addRow.appendChild(sel2);
          addRow.appendChild(btn("Assigner","bg bsm",function(secId,selEl){return function(){
            var uid=selEl.value;if(!uid)return;
            var nd=JSON.parse(JSON.stringify(DB));
            nd.users=nd.users.map(function(x){return x.id===uid?Object.assign({},x,{sid:secId}):x;});
            commit(nd);
          };}(s.id,sel2)));
          card.appendChild(addRow);
        } else if(!avail.length&&refs.length<3){
          card.appendChild(el("div",{style:{fontSize:".7rem",color:GSL,marginTop:"4px"},txt:"Tous les referents sont deja assignes. Ajoutez-en via Equipe."}));
        }
      } else {
        card.appendChild(el("div",{style:{fontSize:".7rem",color:G,fontWeight:"600",marginTop:"4px"},txt:"3 referents assignes (maximum atteint)"}));
      }
      c.appendChild(card);
    });

  } else {
    // ── MODE LISTE : demandes par secteur ──
    var base=sel?DB.reqs.filter(function(r){return r.sid===sel;}):DB.reqs;
    var list=base.filter(function(r){return sf==="all"?true:sf==="approved-undone"?(r.status==="approved"&&!r.doneAt):r.status===sf;}).sort(function(a,b){return b.updatedAt.localeCompare(a.updatedAt);});
    var g=el("div",{cls:"g2",style:{marginBottom:"10px"}});
    var allCard=el("div",{cls:"card",style:{cursor:"pointer",padding:"9px",textAlign:"center",borderColor:!sel?G:GBD,background:!sel?"#E8F5EE":"#fff"}});
    allCard.appendChild(el("div",{style:{fontWeight:"700",fontSize:".72rem",color:!sel?G:"#4A5568"},txt:"Tous"}));
    allCard.appendChild(el("div",{style:{fontSize:".6rem",color:GSL},txt:DB.reqs.length+" dem."}));
    allCard.onclick=function(){window._selSec=null;renderSecs(c);};g.appendChild(allCard);
    SECS.forEach(function(s){
      var n=DB.reqs.filter(function(r){return r.sid===s.id;}).length;
      var a=DB.reqs.filter(function(r){return r.sid===s.id&&r.status==="pending";}).length;
      var refs=DB.users.filter(function(u){return u.role==="ref"&&u.sid===s.id;});
      var on=sel===s.id;
      var card=el("div",{cls:"card",style:{cursor:"pointer",padding:"9px",textAlign:"center",borderColor:on?s.c:GBD,background:on?s.bg:"#fff"}});
      card.appendChild(el("div",{style:{fontWeight:"700",fontSize:".7rem",color:s.c},txt:s.short}));
      card.appendChild(el("div",{style:{fontSize:".6rem",color:GSL},txt:n+" dem."+(a?" / "+a+" att.":"")}));
      card.appendChild(el("div",{style:{fontSize:".58rem",color:s.c,marginTop:"2px"},txt:refs.length+" ref."}));
      card.onclick=function(){window._selSec=on?null:s.id;renderSecs(c);};g.appendChild(card);
    });
    c.appendChild(g);
    if(sel&&SM[sel]){var ss=SM[sel];var refs2=DB.users.filter(function(u){return u.role==="ref"&&u.sid===sel;});var sb=el("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",gap:"8px",marginBottom:"8px",padding:"8px 10px",background:ss.bg,borderRadius:"8px"}});var sbLeft=el("div");sbLeft.appendChild(el("span",{style:{fontWeight:"700",color:ss.c,fontSize:".82rem"},txt:ss.label}));sbLeft.appendChild(el("div",{style:{fontSize:".62rem",color:ss.c,marginTop:"2px"},txt:refs2.map(function(u){return u.name;}).join(", ")||"Aucun referent"}));sb.appendChild(sbLeft);sb.appendChild(btn("PDF","bgr bsm",function(){pdfHisto(DB.reqs.filter(function(r){return r.sid===sel;}),"Historique - "+ss.label);}));c.appendChild(sb);}
    var sfs=[{v:"all",l:"Toutes"},{v:"pending",l:"Attente"},{v:"approved",l:"Approuvees"},{v:"rejected",l:"Refusees"},{v:"done",l:"Effectuees"},{v:"approved-undone",l:"Non faites"}];
    var frow=el("div",{cls:"fbtns"});sfs.forEach(function(f){var b=el("button",{cls:"fbtn"+(sf===f.v?" on":""),txt:f.l});b.onclick=function(){window._sfSec=f.v;renderSecs(c);};frow.appendChild(b);});c.appendChild(frow);
    if(!list.length)c.appendChild(el("div",{cls:"empty",txt:"Aucune demande."}));
    else list.forEach(function(r){c.appendChild(makeRcard(r,true));});
  }
}

function openSecModal(s){
  openModal("Modifier secteur - "+s.label,function(body){
    var lf=el("div",{cls:"fg"});lf.appendChild(el("label",{txt:"Nom complet"}));var li=document.createElement("input");li.id="sm-label";li.value=s.label;lf.appendChild(li);body.appendChild(lf);
    var sf=el("div",{cls:"fg"});sf.appendChild(el("label",{txt:"Abreviation (affichee dans les menus)"}));var si=document.createElement("input");si.id="sm-short";si.value=s.short;si.maxLength=8;sf.appendChild(si);body.appendChild(sf);
    // Color picker
    var cf=el("div",{cls:"fg"});cf.appendChild(el("label",{txt:"Couleur principale"}));
    var cp=document.createElement("input");cp.type="color";cp.id="sm-color";cp.value=s.c;cp.style.cssText="width:100%;height:36px;border:1.5px solid #E2E0DB;border-radius:7px;padding:2px;cursor:pointer;";
    cf.appendChild(cp);body.appendChild(cf);
    // Tips
    var tf=el("div",{cls:"fg"});tf.appendChild(el("label",{txt:"Suggestions (separees par des virgules)"}));var ta=document.createElement("textarea");ta.id="sm-tips";ta.value=s.tips.join(", ");ta.style.cssText="width:100%;padding:8px 10px;border:1.5px solid #E2E0DB;border-radius:7px;font-family:inherit;font-size:.82rem;background:#F8F7F4;min-height:60px;resize:vertical;";tf.appendChild(ta);body.appendChild(tf);
    var btnsRow=el("div",{style:{display:"flex",gap:"8px",justifyContent:"flex-end",marginTop:"10px"}});
    btnsRow.appendChild(btn("Annuler","bgr",closeModal));
    btnsRow.appendChild(btn("Enregistrer","bg",function(){
      var newLabel=document.getElementById("sm-label").value.trim();
      var newShort=document.getElementById("sm-short").value.trim();
      var newColor=document.getElementById("sm-color").value;
      var newTips=document.getElementById("sm-tips").value.split(",").map(function(t){return t.trim();}).filter(function(t){return t;});
      if(!newLabel||!newShort){toast("Nom requis.",false);return;}
      // Update SECS array in place
      var idx=-1;for(var i=0;i<SECS.length;i++){if(SECS[i].id===s.id){idx=i;break;}}
      if(idx>=0){
        SECS[idx]=Object.assign({},SECS[idx],{label:newLabel,short:newShort,c:newColor,tips:newTips});
        SM[s.id]=SECS[idx];
      }
      // Save custom SECS in DB
      var nd=JSON.parse(JSON.stringify(DB));
      nd.secs=JSON.parse(JSON.stringify(SECS));
      commit(nd);
      toast("Secteur modifie !");closeModal();
    }));
    body.appendChild(btnsRow);
  });
}


function renderRefs(c){
  if(ME.role!=="dir"){c.appendChild(el("div",{cls:"empty",txt:"Acces restreint."}));return;}
  var dirs=DB.users.filter(function(u){return u.role==="dir";});
  var refs=DB.users.filter(function(u){return u.role==="ref";});
  var hdr=el("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:"10px"}});
  hdr.appendChild(el("h2",{style:{fontSize:"1rem",fontWeight:"800",color:G,margin:"0"},txt:"Equipe ("+(dirs.length+refs.length)+")"}));
  var btns=el("div",{style:{display:"flex",gap:"6px"}});
  btns.appendChild(btn("+ Direction","bbl bsm",function(){openUserModal(null,"dir");}));
  btns.appendChild(btn("+ Referent","bg bsm",function(){openUserModal(null,"ref");}));
  hdr.appendChild(btns);c.appendChild(hdr);
  // Direction block
  var dirCard=el("div",{cls:"card",style:{padding:"0",overflow:"hidden",marginBottom:"10px"}});
  var dirHdr=el("div",{style:{background:"#DBEAFE",padding:"8px 12px",display:"flex",alignItems:"center",justifyContent:"space-between"}});
  dirHdr.appendChild(el("span",{style:{fontWeight:"800",fontSize:".8rem",color:"#1E3A5F"},txt:"Direction"}));
  dirHdr.appendChild(el("span",{style:{fontSize:".6rem",color:"#1E3A5F",fontWeight:"600"},txt:dirs.length+" membre"+(dirs.length>1?"s":"")}));
  dirCard.appendChild(dirHdr);
  dirs.forEach(function(u,i){
    var row=el("div",{cls:"secrow",style:{borderTop:i===0?"1px solid #E2E0DB":"1px solid rgba(226,224,219,.3)"}});
    row.appendChild(el("div",{cls:"sn",txt:u.name}));
    var meta=el("div",{cls:"sm"});meta.appendChild(el("span",{txt:u.title}));if(u.email){meta.appendChild(el("span",{txt:u.email}));}row.appendChild(meta);
    var sb=el("div",{cls:"sb"});
    sb.appendChild(btn("Modifier","bg bsm",function(uu){return function(){openUserModal(uu,"dir");};}(u)));
    sb.appendChild(btn("Retirer","br bsm",function(uu){return function(){if(!confirm("Retirer "+uu.name+" ?"))return;var nd=JSON.parse(JSON.stringify(DB));nd.users=nd.users.filter(function(x){return x.id!==uu.id;});commit(nd);toast(uu.name+" retire.");};}(u)));
    row.appendChild(sb);dirCard.appendChild(row);
  });
  c.appendChild(dirCard);
  // Refs by sector
  if(!refs.length)c.appendChild(el("div",{cls:"empty",txt:"Aucun referent."}));
  var bySec=SECS.map(function(s){return{s:s,r:refs.filter(function(u){return u.sid===s.id;})};}).filter(function(x){return x.r.length>0;});
  bySec.forEach(function(item){
    var card=el("div",{cls:"card",style:{padding:"0",overflow:"hidden",marginBottom:"8px"}});
    var hd=el("div",{style:{background:item.s.bg,padding:"8px 12px",display:"flex",alignItems:"center",justifyContent:"space-between",gap:"8px"}});
    var hl=el("div",{style:{display:"flex",alignItems:"center",gap:"7px"}});
    hl.appendChild(el("span",{style:{fontWeight:"800",fontSize:".8rem",color:item.s.c},txt:item.s.label}));
    hl.appendChild(el("span",{style:{fontSize:".6rem",color:item.s.c,fontWeight:"600"},txt:item.r.length+" membre"+(item.r.length>1?"s":"")}));
    hd.appendChild(hl);
    hd.appendChild(btn("Retirer equipe","br bsm",function(it){return function(){if(!confirm("Retirer equipe "+it.s.label+"?"))return;var ids=it.r.map(function(u){return u.id;});var nd=JSON.parse(JSON.stringify(DB));nd.users=nd.users.filter(function(u){return ids.indexOf(u.id)===-1;});commit(nd);toast("Equipe retiree.");};}(item)));
    card.appendChild(hd);
    item.r.forEach(function(u,i){
      var mr=DB.reqs.filter(function(r){return r.uid===u.id;});
      var gp=mr.filter(function(r){return r.score===1;}).length;
      var mp=mr.filter(function(r){return r.score===0;}).length;
      var nf=mr.filter(function(r){return r.status==="approved"&&!r.doneAt;}).length;
      var row=el("div",{cls:"secrow",style:{borderTop:i===0?"1px solid #E2E0DB":"1px solid rgba(226,224,219,.3)"}});
      row.appendChild(el("div",{cls:"sn",txt:u.name}));
      var meta=el("div",{cls:"sm"});
      meta.appendChild(atag(u.assoc));
      if(u.email)meta.appendChild(el("span",{txt:u.email}));
      meta.appendChild(el("span",{txt:mr.length+" dem."}));
      meta.appendChild(el("span",{style:{color:"#C8A84B"},txt:"+"+gp}));
      meta.appendChild(el("span",{style:{color:"#C0392B"},txt:"-"+mp}));
      if(nf){meta.appendChild(el("span",{style:{color:"#b45309"},txt:"!"+nf+"NF"}));}
      row.appendChild(meta);
      var sb=el("div",{cls:"sb"});
      sb.appendChild(btn("Modifier","bg bsm",function(uu){return function(){openUserModal(uu,uu.role);};}(u)));
      sb.appendChild(btn("Historique","bgr bsm",function(uu){return function(){openHistModal(uu.id);};}(u)));
      sb.appendChild(btn("Retirer","br bsm",function(uu){return function(){if(!confirm("Retirer "+uu.name+" ?"))return;var nd=JSON.parse(JSON.stringify(DB));nd.users=nd.users.filter(function(x){return x.id!==uu.id;});commit(nd);toast(uu.name+" retire.");};}(u)));
      row.appendChild(sb);card.appendChild(row);
    });
    c.appendChild(card);
  });
}

function openUserModal(user,role){
  if(ME.role!=="dir"){toast("Acces restreint.",false);return;}
  var adding=!user;
  openModal(adding?"Ajouter "+(role==="dir"?"membre direction":"referent"):"Modifier - "+( user?user.name:""),function(body){
    var nf=el("div",{cls:"fg"});nf.appendChild(el("label",{txt:"Nom"}));var ni=document.createElement("input");ni.id="um-n";ni.value=user?user.name:"";nf.appendChild(ni);body.appendChild(nf);
    if(role==="dir"){var tf=el("div",{cls:"fg"});tf.appendChild(el("label",{txt:"Titre"}));var ti=document.createElement("input");ti.id="um-ti";ti.value=user&&user.title?user.title:"";tf.appendChild(ti);body.appendChild(tf);}
    if(role==="ref"){
      var sf=el("div",{cls:"fg"});sf.appendChild(el("label",{txt:"Secteur"}));var ss=document.createElement("select");ss.id="um-s";SECS.forEach(function(s){var o=document.createElement("option");o.value=s.id;o.textContent=s.label;if(user&&user.sid===s.id)o.selected=true;ss.appendChild(o);});sf.appendChild(ss);body.appendChild(sf);
      var af=el("div",{cls:"fg"});af.appendChild(el("label",{txt:"Association"}));var as=document.createElement("select");as.id="um-a";["ACMS","CCIS","ACMS/CCIS"].forEach(function(v){var o=document.createElement("option");o.value=v;o.textContent=v;if(user&&user.assoc===v)o.selected=true;as.appendChild(o);});af.appendChild(as);body.appendChild(af);
    }
    var ef=el("div",{cls:"fg"});ef.appendChild(el("label",{txt:"Email"}));var ei=document.createElement("input");ei.type="email";ei.id="um-e";ei.value=user&&user.email?user.email:"";ef.appendChild(ei);body.appendChild(ef);
    var pf=el("div",{cls:"fg"});pf.appendChild(el("label",{txt:adding?"Code acces":"Nouveau code (vide=inchange)"}));var pi=document.createElement("input");pi.type="password";pi.id="um-p";pi.maxLength=8;pi.placeholder=adding?"1234":"Laisser vide";pf.appendChild(pi);body.appendChild(pf);
    if(!adding){var info=el("div",{style:{background:"#FFF3CD",borderRadius:"7px",padding:"7px 10px",marginBottom:"10px",fontSize:".72rem",color:"#856404"},txt:"Code actuel conserve si champ vide."});body.appendChild(info);}
    var btnsRow=el("div",{style:{display:"flex",gap:"8px",justifyContent:"flex-end",marginTop:"10px"}});
    btnsRow.appendChild(btn("Annuler","bgr",closeModal));
    btnsRow.appendChild(btn(adding?"Ajouter":"Enregistrer","bg",function(){
      var name=$("um-n").value.trim();if(!name){toast("Nom requis.",false);return;}
      var title=role==="dir"?($("um-ti")?$("um-ti").value.trim():""):"";
      var sid=role==="ref"?($("um-s")?$("um-s").value:""):"";
      var assoc=role==="ref"?($("um-a")?$("um-a").value:""):"";
      var email=$("um-e").value.trim();
      var pin=$("um-p").value;
      function apply(ph){
        var nd=JSON.parse(JSON.stringify(DB));
        if(adding){nd.users.push({id:(role==="dir"?"dir":"rf")+Date.now(),name:name,role:role,pinHash:ph,title:title,assoc:assoc,sid:sid,email:email,phone:"",registered:role==="dir",token:role==="ref"?Date.now().toString(36):""});}
        else{nd.users=nd.users.map(function(u){if(u.id!==user.id)return u;return role==="dir"?Object.assign({},u,{name:name,pinHash:ph,title:title,email:email}):Object.assign({},u,{name:name,pinHash:ph,assoc:assoc,sid:sid,email:email});});}
        commit(nd);toast(name+(adding?" ajoute":" modifie")+".");closeModal();
      }
      if(pin.trim()){hashPin(pin,apply);}else if(adding){hashPin("1234",apply);}else{apply(user.pinHash);}
    }));
    body.appendChild(btnsRow);
  });
}

function renderInvites(c){
  if(ME.role!=="dir"){c.appendChild(el("div",{cls:"empty",txt:"Acces restreint."}));return;}
  var refs=DB.users.filter(function(u){return u.role==="ref";});
  var baseUrl="https://gms-cahier-de-suivi.netlify.app";
  c.appendChild(el("h2",{style:{fontSize:"1rem",fontWeight:"800",color:G,margin:"0 0 4px"},txt:"Invitations"}));
  c.appendChild(el("p",{style:{fontSize:".72rem",color:GSL,marginBottom:"12px"},txt:"Envoyez le lien personalise a chaque referent pour qu il s inscrive."}));
  refs.forEach(function(u){
    var sec=SM[u.sid]||null;
    var link=u.token?baseUrl+"?invite="+u.token:"";
    var card=el("div",{cls:"card",style:{marginBottom:"8px"}});
    var top=el("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",gap:"8px",marginBottom:"6px"}});
    var left=el("div");
    left.appendChild(el("div",{style:{fontWeight:"700",fontSize:".84rem"},txt:u.name}));
    if(sec)left.appendChild(el("div",{style:{fontSize:".68rem",color:sec.c,marginTop:"1px"},txt:sec.label+" ("+u.assoc+")"}));
    if(u.email)left.appendChild(el("div",{style:{fontSize:".66rem",color:GSL},txt:u.email}));
    top.appendChild(left);
    var stbdg2=el("span",{cls:"bdg"});stbdg2.style.background=u.registered?"#E8F5EE":"#FFF3CD";stbdg2.style.color=u.registered?"#1B5E42":"#856404";stbdg2.textContent=u.registered?"Inscrit":"En attente";top.appendChild(stbdg2);
    card.appendChild(top);
    if(u.registered){card.appendChild(el("div",{style:{fontSize:".7rem",color:G,fontWeight:"600"},txt:"Inscription complete"}));}
    else if(link){
      var linkEl=el("div",{style:{fontSize:".68rem",color:GSL,marginBottom:"7px",wordBreak:"break-all",background:"#F8F7F4",padding:"6px 8px",borderRadius:"6px"},txt:link});card.appendChild(linkEl);
      var btnsRow=el("div",{style:{display:"flex",gap:"6px",flexWrap:"wrap"}});
      btnsRow.appendChild(btn("Copier lien","bg bsm",function(lnk){return function(){if(navigator.clipboard){navigator.clipboard.writeText(lnk).then(function(){toast("Lien copie !");});}else{var ta=document.createElement("textarea");ta.value=lnk;document.body.appendChild(ta);ta.select();document.execCommand("copy");document.body.removeChild(ta);toast("Lien copie !");}};}(link)));
      btnsRow.appendChild(btn("SMS","bgr bsm",function(n,lnk){return function(){window.open("sms:?body="+encodeURIComponent("Salam "+n+", voici votre lien inscription Cahier de Suivi Grande Mosquee Sartrouville : "+lnk));};}(u.name,link)));
      btnsRow.appendChild(btn("WhatsApp","bsm",function(n,lnk){return function(){window.open("https://wa.me/?text="+encodeURIComponent("Salam "+n+", voici votre lien inscription Cahier de Suivi Grande Mosquee Sartrouville : "+lnk));};}(u.name,link)));
      btnsRow.style.cssText="background:#25D366;color:#fff;";
      var waBtn=btnsRow.lastChild;waBtn.style.background="#25D366";waBtn.style.color="#fff";
      card.appendChild(btnsRow);
    }
    var actRow=el("div",{style:{marginTop:"7px",display:"flex",gap:"6px",flexWrap:"wrap"}});
    actRow.appendChild(btn("Regenerer lien","bgr bsm",function(uu){return function(){if(!confirm("Regenerer un nouveau lien ?"))return;var nd=JSON.parse(JSON.stringify(DB));nd.users=nd.users.map(function(x){return x.id===uu.id?Object.assign({},x,{token:Date.now().toString(36)}):x;});commit(nd);toast("Nouveau lien genere !");};}(u)));
    if(u.registered){actRow.appendChild(btn("Reinitialiser","bsm",function(uu){return function(){if(!confirm("Reinitialiser inscription de "+uu.name+" ?"))return;var nd=JSON.parse(JSON.stringify(DB));nd.users=nd.users.map(function(x){return x.id===uu.id?Object.assign({},x,{registered:false,token:Date.now().toString(36),pinHash:PIN0,email:"",phone:""}):x;});commit(nd);toast("Reinitialise.");};}(u)));var rb=actRow.lastChild;rb.style.background="#F59E0B";rb.style.color="#fff";}
    card.appendChild(actRow);c.appendChild(card);
  });
}

function openHistModal(uid){
  var u=DB.users.find(function(x){return x.id===uid;});if(!u)return;
  var sec=SM[u.sid]||null;
  var reqs=DB.reqs.filter(function(r){return r.uid===uid;}).sort(function(a,b){return b.createdAt.localeCompare(a.createdAt);});
  openModal("Historique - "+u.name,function(body){
    if(sec){var sb=el("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:"10px",padding:"7px 10px",background:sec.bg,borderRadius:"7px"}});sb.appendChild(el("span",{style:{fontWeight:"700",color:sec.c,fontSize:".8rem"},txt:sec.label}));sb.appendChild(btn("PDF","bgr bsm",function(){pdfHisto(reqs,"Historique - "+u.name);}));body.appendChild(sb);}
    body.appendChild(el("p",{style:{fontSize:".7rem",color:GSL,marginBottom:"8px"},txt:reqs.length+" demande"+(reqs.length>1?"s":"")}));
    if(!reqs.length)body.appendChild(el("div",{cls:"empty",txt:"Aucune."}));
    else reqs.forEach(function(r){var rc=makeRcard(r,true);body.appendChild(rc);});
  });
}

function openReqModal(rid){
  var r=DB.reqs.find(function(x){return x.id===rid;});if(!r)return;
  var isDir=ME.role==="dir";
  if(!isDir&&r.uid!==ME.id)return;
  var sec=SM[r.sid]||null;
  openModal(r.title,function(body){
    var chips=el("div",{style:{display:"flex",gap:"4px",flexWrap:"wrap",marginBottom:"8px"}});
    chips.appendChild(stbdg(r));chips.appendChild(tybdg(r));chips.appendChild(atag(r.assoc));
    if(sec){chips.appendChild(bdg(sec.bg,sec.c,sec.short));}
    if(r.prio==="urgente")chips.appendChild(bdg("#FEE2E2","#C0392B","URGENT"));
    body.appendChild(chips);
    var dem=el("div",{style:{background:"#E8F5EE",borderRadius:"8px",padding:"9px 11px",marginBottom:"8px",borderLeft:"3px solid #1B5E42",fontSize:".72rem",lineHeight:"1.8"}});
    dem.appendChild(el("div",{style:{fontWeight:"800",color:G,fontSize:".8rem",marginBottom:"1px"},txt:"Demandeur : "+un(r.uid)}));
    var info=el("div",{style:{color:GSL}});info.innerHTML="<b>Cree :</b> "+fdt(r.createdAt)+"<br><b>Modifie :</b> "+fdt(r.updatedAt)+(r.doneAt?"<br><b>Effectue :</b> "+fdt(r.doneAt):"");
    dem.appendChild(info);body.appendChild(dem);
    if(r.desc)body.appendChild(el("p",{style:{fontSize:".82rem",lineHeight:"1.6",marginBottom:"8px"},txt:r.desc}));
    if(r.score!==null){var sv=el("div",{style:{padding:"5px 9px",background:"rgba(200,168,75,.12)",borderRadius:"6px",marginBottom:"8px",fontSize:".78rem"},txt:r.score===1?"Bon point":"Mauvais point"});body.appendChild(sv);}
    if((r.files||[]).length){
      var fhdr=el("div",{style:{marginBottom:"8px"}});fhdr.appendChild(el("div",{style:{fontSize:".66rem",fontWeight:"700",color:"#4A5568",textTransform:"uppercase",marginBottom:"5px"},txt:"Pieces jointes"}));
      r.files.forEach(function(f){var row=el("div",{style:{display:"flex",alignItems:"center",gap:"7px",padding:"4px 8px",background:GB,borderRadius:"5px",marginBottom:"3px",fontSize:".74rem"}});row.appendChild(el("span",{style:{flex:"1",overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"},txt:f.name}));if(f.data){var a=document.createElement("a");a.href=f.data;a.download=f.name;a.textContent="Telecharger";a.style.color=G;a.style.fontWeight="700";a.style.fontSize=".68rem";row.appendChild(a);}fhdr.appendChild(row);});
      body.appendChild(fhdr);
    }
    var fi2=document.createElement("input");fi2.type="file";fi2.style.display="none";
    body.appendChild(btn("Joindre fichier","bgr bsm",function(){fi2.click();}));
    body.appendChild(fi2);
    fi2.onchange=function(e){var f=e.target.files[0];if(!f)return;var rd=new FileReader();rd.onload=function(ev){var nd=JSON.parse(JSON.stringify(DB));var req=nd.reqs.find(function(x){return x.id===rid;});req.files=(req.files||[]).concat([{name:f.name,type:f.type,size:f.size,data:ev.target.result}]);req.updatedAt=new Date().toISOString();commit(nd);toast("Fichier joint.");openReqModal(rid);};rd.readAsDataURL(f);};
    body.appendChild(el("hr",{cls:"hr"}));
    if((r.msgs||[]).length){
      var mhdr=el("div",{style:{marginBottom:"8px"}});mhdr.appendChild(el("div",{style:{fontSize:".66rem",fontWeight:"700",color:"#4A5568",textTransform:"uppercase",marginBottom:"5px"},txt:"Echanges"}));
      r.msgs.forEach(function(m){var ico=m.type==="remark"?"[R]":m.type==="suggestion"?"[S]":"[C]";var mi2=el("div",{style:{background:GB,borderRadius:"7px",padding:"6px 9px",marginBottom:"5px"}});mi2.appendChild(el("span",{style:{fontSize:".64rem",fontWeight:"700",color:G},txt:ico+" "+un(m.uid)}));mi2.appendChild(el("span",{style:{fontSize:".6rem",color:GSL,float:"right"},txt:fdt(m.date)}));mi2.appendChild(el("div",{style:{fontSize:".8rem",marginTop:"2px"},txt:m.text}));mhdr.appendChild(mi2);});
      body.appendChild(mhdr);
    }
    var curMt="comment";
    var mtypes=el("div",{style:{display:"flex",gap:"5px",marginBottom:"5px"}});
    [{v:"comment",l:"Commentaire"},{v:"remark",l:"Remarque"},{v:"suggestion",l:"Suggestion"}].forEach(function(mt){var b=el("button",{cls:"fbtn"+(curMt===mt.v?" on":""),txt:mt.l});b.onclick=function(){curMt=mt.v;mtypes.querySelectorAll(".fbtn").forEach(function(x){x.classList.remove("on");});b.classList.add("on");};mtypes.appendChild(b);});
    body.appendChild(mtypes);
    var mta=document.createElement("textarea");mta.placeholder="Votre message...";mta.style.cssText="width:100%;padding:7px 9px;border:1.5px solid #E2E0DB;border-radius:7px;font-family:inherit;font-size:.82rem;background:#F8F7F4;min-height:48px;resize:vertical;";body.appendChild(mta);
    body.appendChild(btn("Envoyer","bg bsm",function(){var txt=mta.value.trim();if(!txt)return;var nd=JSON.parse(JSON.stringify(DB));var req=nd.reqs.find(function(x){return x.id===rid;});req.msgs=(req.msgs||[]).concat([{id:"m"+Date.now(),uid:ME.id,text:txt,date:new Date().toISOString(),type:curMt}]);req.updatedAt=new Date().toISOString();commit(nd);toast("Envoye.");openReqModal(rid);}));
    if(isDir){
      body.appendChild(el("hr",{cls:"hr"}));
      body.appendChild(el("div",{style:{fontSize:".66rem",fontWeight:"700",color:"#4A5568",textTransform:"uppercase",marginBottom:"7px"},txt:"Actions direction"}));
      var actBtns=el("div",{style:{display:"flex",gap:"6px",flexWrap:"wrap",marginBottom:"8px"}});
      if(r.status==="pending"){actBtns.appendChild(btn("Approuver","bg bsm",function(){chSt(rid,"approved");}));actBtns.appendChild(btn("Rejeter","br bsm",function(){chSt(rid,"rejected");}));}
      if(r.status==="approved"&&!r.doneAt){var db2=btn("Marquer effectuee","bsm",function(){chSt(rid,"done");});db2.style.background="#3730A3";db2.style.color="#fff";actBtns.appendChild(db2);}
      if(r.status==="rejected"){var rb=btn("Remettre en attente","bsm",function(){chSt(rid,"pending");});rb.style.background="#C8A84B";rb.style.color="#fff";actBtns.appendChild(rb);}
      body.appendChild(actBtns);
      var evRow=el("div",{style:{display:"flex",alignItems:"center",gap:"8px",flexWrap:"wrap",marginBottom:"8px"}});
      evRow.appendChild(el("span",{style:{fontSize:".74rem",fontWeight:"700"},txt:"Evaluation :"}));
      var sp=btn("+","bsm",function(){setScore(rid,r.score===1?null:1);});sp.style.cssText="background:none;border:none;font-size:1.1rem;opacity:"+(r.score===1?1:.3)+";";evRow.appendChild(sp);
      evRow.appendChild(el("span",{style:{fontSize:".68rem",color:"#C8A84B"},txt:"Bon"}));
      var sm2=btn("-","bsm",function(){setScore(rid,r.score===0?null:0);});sm2.style.cssText="background:none;border:none;font-size:1.1rem;opacity:"+(r.score===0?1:.3)+";";evRow.appendChild(sm2);
      evRow.appendChild(el("span",{style:{fontSize:".68rem",color:"#C0392B"},txt:"Mauvais"}));
      if(r.score!==null){evRow.appendChild(btn("Effacer","bgr bsm",function(){setScore(rid,null);}));}
      body.appendChild(evRow);
    }
    body.appendChild(el("hr",{cls:"hr"}));
    body.appendChild(btn("Imprimer / PDF","bgr bsm",function(){pdfReqFn(rid);}));
  });
}
function chSt(rid,ns){var nd=JSON.parse(JSON.stringify(DB));var req=nd.reqs.find(function(x){return x.id===rid;});req.status=ns;req.updatedAt=new Date().toISOString();if(ns==="done")req.doneAt=new Date().toISOString();commit(nd);toast("Statut mis a jour.");openReqModal(rid);}
function setScore(rid,v){var nd=JSON.parse(JSON.stringify(DB));var req=nd.reqs.find(function(x){return x.id===rid;});req.score=v;req.updatedAt=new Date().toISOString();commit(nd);openReqModal(rid);}

function renderForum(c){
  if(ME.role!=="dir"){c.appendChild(el("div",{cls:"empty",txt:"Le forum est reserve a la direction."}));return;}
  var isDir=ME.role==="dir";
  var posts=[].concat(DB.forum).sort(function(a,b){if(a.pinned&&!b.pinned)return -1;if(!a.pinned&&b.pinned)return 1;return b.createdAt.localeCompare(a.createdAt);});
  var hdr=el("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:"10px"}});
  hdr.appendChild(el("h2",{style:{fontSize:"1rem",fontWeight:"800",color:G,margin:"0"},txt:"Forum"}));
  hdr.appendChild(btn("+ Nouveau","bg bsm",function(){
    openModal("Nouveau sujet",function(body){
      var tf=el("div",{cls:"fg"});tf.appendChild(el("label",{txt:"Titre"}));var ti=document.createElement("input");ti.id="fp-t";tf.appendChild(ti);body.appendChild(tf);
      var bf=el("div",{cls:"fg"});bf.appendChild(el("label",{txt:"Contenu"}));var bi=document.createElement("textarea");bi.id="fp-b";bi.style.minHeight="70px";bf.appendChild(bi);body.appendChild(bf);
      var btnsRow=el("div",{style:{display:"flex",gap:"8px",justifyContent:"flex-end",marginTop:"8px"}});
      btnsRow.appendChild(btn("Annuler","bgr",closeModal));
      btnsRow.appendChild(btn("Publier","bg",function(){var t=$("fp-t").value.trim();var b=$("fp-b").value.trim();if(!t||!b){toast("Titre et contenu requis.",false);return;}var nd=JSON.parse(JSON.stringify(DB));nd.forum.push({id:"f"+Date.now(),uid:ME.id,title:t,body:b,createdAt:new Date().toISOString(),replies:[],pinned:false});commit(nd);toast("Publie !");closeModal();}));
      body.appendChild(btnsRow);
    });
  }));
  c.appendChild(hdr);
  if(!posts.length)c.appendChild(el("div",{cls:"empty",txt:"Aucun sujet."}));
  posts.forEach(function(pp){
    var card=el("div",{cls:"card"});if(pp.pinned)card.style.borderLeft="4px solid #C8A84B";
    var top=el("div",{style:{display:"flex",alignItems:"flex-start",justifyContent:"space-between",gap:"7px",marginBottom:"5px"}});
    var left=el("div",{style:{flex:"1",minWidth:"0"}});
    if(pp.pinned){var pb=el("span",{cls:"bdg"});pb.style.background="rgba(200,168,75,.15)";pb.style.color="#C8A84B";pb.textContent="Epingle";left.appendChild(pb);left.appendChild(document.createTextNode(" "));}
    left.appendChild(el("span",{style:{fontWeight:"800",fontSize:".86rem"},txt:pp.title}));
    left.appendChild(el("div",{style:{fontSize:".62rem",color:GSL,marginTop:"2px"},txt:un(pp.uid)+" - "+fdt(pp.createdAt)+" - "+pp.replies.length+" rep."}));
    top.appendChild(left);
    var rights=el("div",{style:{display:"flex",gap:"4px",flexShrink:"0"}});
    if(isDir){rights.appendChild(btn(pp.pinned?"Desep.":"Epingler","bgr bsm",function(pid,pin){return function(){var nd=JSON.parse(JSON.stringify(DB));nd.forum=nd.forum.map(function(p){return p.id===pid?Object.assign({},p,{pinned:!p.pinned}):p;});commit(nd);};}(pp.id,pp.pinned)));}
    if(isDir||pp.uid===ME.id){rights.appendChild(btn("Suppr.","br bsm",function(pid){return function(){if(!confirm("Supprimer ?"))return;var nd=JSON.parse(JSON.stringify(DB));nd.forum=nd.forum.filter(function(p){return p.id!==pid;});commit(nd);toast("Supprime.");};}(pp.id)));}
    top.appendChild(rights);card.appendChild(top);
    card.appendChild(el("p",{style:{fontSize:".8rem",lineHeight:"1.55",marginBottom:"7px"},txt:pp.body}));
    if(pp.replies.length){
      var exp=window._exp&&window._exp[pp.id];
      var tb=btn((exp?"Masquer":"Voir "+pp.replies.length+" rep."),"bgr bsm",function(pid){return function(){window._exp=window._exp||{};window._exp[pid]=!window._exp[pid];renderForum(c);};}(pp.id));
      tb.style.marginBottom="5px";card.appendChild(tb);
      if(exp){pp.replies.forEach(function(rr){var ri=el("div",{style:{background:GB,borderRadius:"6px",padding:"5px 9px",marginBottom:"4px"}});ri.appendChild(el("span",{style:{fontSize:".62rem",fontWeight:"700",color:G},txt:un(rr.uid)}));ri.appendChild(el("span",{style:{fontSize:".6rem",color:GSL,float:"right"},txt:fdt(rr.date)}));ri.appendChild(el("div",{style:{fontSize:".78rem",marginTop:"2px"},txt:rr.text}));card.appendChild(ri);});}
    }
    var repRow=el("div",{style:{display:"flex",gap:"6px"}});
    var ri=document.createElement("input");ri.placeholder="Votre reponse...";ri.style.cssText="flex:1;padding:6px 9px;border:1.5px solid #E2E0DB;border-radius:7px;font-family:inherit;font-size:.76rem;background:#F8F7F4;";
    repRow.appendChild(ri);
    repRow.appendChild(btn("Rep.","bg bsm",function(pid,inp){return function(){var t=inp.value.trim();if(!t)return;var nd=JSON.parse(JSON.stringify(DB));nd.forum=nd.forum.map(function(p){return p.id!==pid?p:Object.assign({},p,{replies:p.replies.concat([{id:"fr"+Date.now(),uid:ME.id,text:t,date:new Date().toISOString()}])});});commit(nd);toast("Reponse ajoutee.");};}(pp.id,ri)));
    card.appendChild(repRow);c.appendChild(card);
  });
}

function renderCfg(c){
  var sec=SM[ME.sid]||null;
  c.appendChild(el("h2",{style:{fontSize:"1rem",fontWeight:"800",color:G,margin:"0 0 10px"},txt:"Parametres"+(sec?" - "+sec.short:"")}));
  var pc=el("div",{cls:"card",style:{marginBottom:"8px"}});
  pc.appendChild(el("div",{style:{fontWeight:"700",fontSize:".82rem",color:G,marginBottom:"8px"},txt:"Code acces"}));
  var pg=el("div",{cls:"g2",style:{marginBottom:"7px"}});
  var npf=el("div",{cls:"fg"});npf.appendChild(el("label",{txt:"Nouveau"}));var npi=document.createElement("input");npi.type="password";npi.id="c-np";npi.maxLength=8;npi.placeholder="Nouveau";npf.appendChild(npi);pg.appendChild(npf);
  var cpf=el("div",{cls:"fg"});cpf.appendChild(el("label",{txt:"Confirmer"}));var cpi=document.createElement("input");cpi.type="password";cpi.id="c-cp";cpi.maxLength=8;cpi.placeholder="Confirmer";cpf.appendChild(cpi);pg.appendChild(cpf);
  pc.appendChild(pg);
  pc.appendChild(btn("Mettre a jour","bg bsm",function(){var np=$("c-np").value;var cp=$("c-cp").value;if(np.length<4){toast("Min. 4 car.",false);return;}if(np!==cp){toast("Codes differents.",false);return;}hashPin(np,function(ph){var nd=JSON.parse(JSON.stringify(DB));nd.users=nd.users.map(function(u){return u.id===ME.id?Object.assign({},u,{pinHash:ph}):u;});ME=Object.assign({},ME,{pinHash:ph});commit(nd);toast("Code mis a jour !");$("c-np").value="";$("c-cp").value="";}); }));
  c.appendChild(pc);
  var ec=el("div",{cls:"card",style:{marginBottom:"8px"}});
  ec.appendChild(el("div",{style:{fontWeight:"700",fontSize:".82rem",color:G,marginBottom:"8px"},txt:"Email"}));
  var ef=el("div",{cls:"fg"});var ei=document.createElement("input");ei.type="email";ei.id="c-em";ei.value=ME.email||"";ei.placeholder="email@exemple.com";ef.appendChild(ei);ec.appendChild(ef);
  ec.appendChild(btn("Sauvegarder","bg bsm",function(){var em=$("c-em").value.trim();var nd=JSON.parse(JSON.stringify(DB));nd.users=nd.users.map(function(u){return u.id===ME.id?Object.assign({},u,{email:em}):u;});ME=Object.assign({},ME,{email:em});commit(nd);toast("Email sauvegarde !");}));
  c.appendChild(ec);
  var pdfCard=el("div",{cls:"card",style:{marginBottom:"8px"}});
  pdfCard.appendChild(el("div",{style:{fontWeight:"700",fontSize:".82rem",color:G,marginBottom:"6px"},txt:"Mes demandes PDF"}));
  pdfCard.appendChild(btn("Exporter mes demandes","bg bsm",function(){var myReqs=DB.reqs.filter(function(r){return r.uid===ME.id;});if(!myReqs.length){toast("Aucune demande.",false);return;}pdfHisto(myReqs,"Mes demandes - "+ME.name);}));
  c.appendChild(pdfCard);
  if(ME.role==="dir"){
    var sc=el("div",{cls:"card"});
    sc.appendChild(el("div",{style:{fontWeight:"700",fontSize:".82rem",color:G,marginBottom:"6px"},txt:"Synchronisation"}));
    sc.appendChild(el("p",{style:{fontSize:".72rem",color:GSL,marginBottom:"8px"},txt:"Exportez puis importez pour synchroniser entre telephones."}));
    var sbtns=el("div",{style:{display:"flex",gap:"8px",flexWrap:"wrap"}});
    sbtns.appendChild(btn("Exporter","bg bsm",function(){var json=JSON.stringify(DB);var blob=new Blob([json],{type:"application/json"});var a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="cahier-"+new Date().toISOString().slice(0,10)+".json";a.click();toast("Exporte !");}));
    var fi3=document.createElement("input");fi3.type="file";fi3.accept=".json";fi3.style.display="none";
    sbtns.appendChild(btn("Importer","bgr bsm",function(){fi3.click();}));
    fi3.onchange=function(e){var f=e.target.files[0];if(!f)return;var rd=new FileReader();rd.onload=function(ev){try{var data=JSON.parse(ev.target.result);if(!data.users||!data.reqs){toast("Fichier invalide.",false);return;}if(!confirm("Remplacer toutes les donnees ?"))return;DB=data;saveDB();render();toast("Importe !");}catch(e2){toast("Erreur fichier.",false);}};rd.readAsText(f);};
    sc.appendChild(sbtns);sc.appendChild(fi3);c.appendChild(sc);
  }
}

function pdfReqFn(rid){
  var r=DB.reqs.find(function(x){return x.id===rid;});if(!r)return;
  var sec=SM[r.sid]||{};var ds=dstat(r);var st=ST[ds]||ST.pending;var ty=TY[r.type]||TY.tache;
  var rows=[["Demandeur",un(r.uid)],["Association",r.assoc],["Secteur",sec.label||"-"],["Cree le",fdt(r.createdAt)],["Type",ty.l],["Statut",st.l]];
  if(r.score!==null)rows.push(["Evaluation",r.score===1?"Bon point":"Mauvais point"]);
  var tbl="<table>"+rows.map(function(x){return"<tr><td>"+x[0]+"</td><td>"+x[1]+"</td></tr>";}).join("")+"</table>";
  var msgs=(r.msgs||[]).map(function(m){return"<p><b>"+un(m.uid)+"</b> ("+fdt(m.date)+"): "+m.text+"</p>";}).join("");
  openPrint("Demande: "+r.title,"<h2>"+r.title+"</h2>"+tbl+(r.desc?"<p>"+r.desc+"</p>":"")+(msgs?"<h3>Echanges</h3>"+msgs:""));
}
function pdfHisto(reqs,titre){
  var body=reqs.sort(function(a,b){return b.createdAt.localeCompare(a.createdAt);}).map(function(r){var sec=SM[r.sid]||{};var ds=dstat(r);return"<div style='border:1px solid #ddd;border-radius:5px;padding:10px;margin-bottom:10px;'><h3>"+r.title+"</h3><table><tr><td>Demandeur</td><td>"+un(r.uid)+"</td></tr><tr><td>Secteur</td><td>"+(sec.label||"-")+"</td></tr><tr><td>Statut</td><td>"+(ST[ds]||ST.pending).l+"</td></tr><tr><td>Date</td><td>"+fdt(r.createdAt)+"</td></tr></table>"+(r.desc?"<p>"+r.desc+"</p>":"")+"</div>";}).join("");
  openPrint(titre,body);
}
function openPrint(titre,body){
  // Creer un iframe invisible pour impression iOS
  var old=document.getElementById("print-frame");
  if(old)old.parentNode.removeChild(old);
  var iframe=document.createElement("iframe");
  iframe.id="print-frame";
  iframe.style.cssText="position:fixed;top:-9999px;left:-9999px;width:210mm;height:297mm;border:none;";
  document.body.appendChild(iframe);
  var doc=iframe.contentDocument||iframe.contentWindow.document;
  doc.open();
  doc.write("<!DOCTYPE html><html><head><meta charset=UTF-8><title>"+titre+"<\/title><style>body{font-family:Arial,sans-serif;padding:20px;font-size:12px;}h1,h2,h3{color:#1B5E42;}table{width:100%;border-collapse:collapse;margin-bottom:8px;}td{padding:4px 7px;border:1px solid #ddd;}td:first-child{font-weight:700;background:#f8f8f8;width:30%;}<\/style><\/head><body><h1>Grande Mosquee de Sartrouville<\/h1><div style='font-size:.7rem;color:#718096;margin-bottom:14px;'>"+titre+" - "+fdt(new Date().toISOString())+"<\/div>"+body+"<\/body><\/html>");
  doc.close();
  setTimeout(function(){
    try{iframe.contentWindow.focus();iframe.contentWindow.print();}
    catch(e){window.print();}
  },500);
}
